# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Source code files (Always LF)
*.cs text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.props text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf

# Visual Studio solution files
*.sln text eol=crlf

# Binary files
*.png binary
*.ico binary
*.pdf binary
