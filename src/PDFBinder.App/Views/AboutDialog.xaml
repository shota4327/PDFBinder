<Window x:Class="PDFBinder.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDF Binder について"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="16"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ヘッダー：アイコン、タイトル、バージョンバッジ -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/PDFBinder;component/Assets/icon.png"
                       Width="64" Height="64" Margin="0,0,0,12"
                       HorizontalAlignment="Center" />
                <TextBlock Text="PDF Binder"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <!-- バージョンバッジ -->
                <Border Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,3"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="VersionTextBlock"
                               Text="v0.1.0"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>

            <!-- キャッチコピー -->
            <TextBlock Grid.Row="1"
                       Text="直感的で軽快なWindows向けPDFバインダー＆手書き編集ツール"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- 区切り線 -->
            <Rectangle Grid.Row="2" Height="1"
                       Fill="{StaticResource SurfaceBorderBrush}"
                       Margin="0,0,0,16" />

            <!-- 詳細情報リスト -->
            <StackPanel Grid.Row="3" Margin="8,0,8,20">
                <!-- ランタイム情報 -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ランタイム"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text=".NET 10.0 (win-x64)"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- ライセンス情報 -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ライセンス"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="寛容型オープンソース (MIT / Apache-2.0 / BSD)"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- 著作権 -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="著作権"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Copyright © 2026 PDF Binder Contributors"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- リポジトリURL -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GitHub"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12">
                        <Hyperlink NavigateUri="https://github.com/shota4327/PDFBinder"
                                   RequestNavigate="OnRequestNavigate"
                                   Foreground="{StaticResource AccentBrush}">
                            shota4327/PDFBinder
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- フッター：閉じるボタン -->
            <Button Grid.Row="4"
                    Content="閉じる"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    Width="100"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
