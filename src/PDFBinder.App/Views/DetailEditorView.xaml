<UserControl x:Class="PDFBinder.App.Views.DetailEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:PDFBinder.App.Controls"
             xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    
    <Grid Background="#E2E8F0">
        <!-- 空白時のウェルカム表示 -->
        <Border Visibility="{Binding Pages.Count, Converter={StaticResource InverseCountToVisibilityConverter}, FallbackValue=Visible}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="12" Padding="40,30" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.1" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="PDFファイルを開くか、ここにドラッグ＆ドロップしてください" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
                <TextBlock Text="複数PDFの結合、ページの並び替え・回転・削除、手書き記入が可能です" 
                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Content="ファイルを開く..." 
                        Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                        Padding="20,8" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- メインキャンバス領域（縦連続スクロール表示） -->
        <controls:NoAutoScrollScrollViewer x:Name="DetailScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollViewerScrollChanged"
                      Padding="30">
            <ItemsControl x:Name="PagesItemsControl" ItemsSource="{Binding Pages}" HorizontalAlignment="Center">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DetailPageItemViewModel}">
                        <!-- 影とページコンテンツを分離したレイアウトコンテナ -->
                        <Grid Margin="0,15"
                              HorizontalAlignment="Center"
                              PreviewMouseDown="OnPagePreviewMouseDown">
                            <!-- 影専用の背景要素（子要素を持たないため、InkCanvas描画中にシェーダー再計算・再ラスタライズが発生しない） -->
                            <Border Background="White"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="#CBD5E1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.15" />
                                </Border.Effect>
                            </Border>

                            <!-- ページ描画コンテナ（Effectがかかっていないため超高速描画） -->
                            <Grid Width="{Binding Page.DisplayWidth}" Height="{Binding Page.DisplayHeight}" ClipToBounds="True">
                                <!-- 背景PDFレンダリング画像 -->
                                <Image Source="{Binding PageBackground}" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- 確定済みストロークの透過ビットマップキャッシュ画像 -->
                                <Image Source="{Binding StrokeCache}" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- 前面手書きInkCanvas（ペン描画中は現在描画中の1画のみを保持して超高速動作） -->
                                <controls:EditorInkCanvas PageItem="{Binding}"
                                                          ToolMode="{Binding DataContext.SelectedTool, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          IsStraightLine="{Binding DataContext.IsStraightLine, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DrawingColor="{Binding DataContext.SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Background="Transparent" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:NoAutoScrollScrollViewer>
    </Grid>
</UserControl>
