<UserControl x:Class="PDFBinder.App.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:PDFBinder.Core.Models;assembly=PDFBinder.Core"
             xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- 空白時のウェルカム表示 -->
        <Border Visibility="{Binding Document.Pages.Count, Converter={StaticResource InverseCountToVisibilityConverter}, FallbackValue=Visible}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="40,30" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE415;" FontFamily="{StaticResource IconFontFamily}" FontSize="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="PDFファイルを開くか、ここにドラッグ＆ドロップしてください" 
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="複数PDFの結合、ページの並び替え・回転・削除、手書き記入が可能です" 
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Content="ファイルを開く..." Command="{Binding OpenDocumentCommand}" 
                        Padding="20,8" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- サムネイル一覧グリッド（最下部スクロール時にカードがステータスバーに隠れないよう下部オフセット62pxを確保） -->
        <!-- サムネイル一覧グリッド（最下部スクロール時にカードがステータスバーに隠れないよう下部オフセット62pxを確保） -->
        <ScrollViewer x:Name="GridScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,20,20,62"
                      Background="Transparent"
                      AllowDrop="True"
                      MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"
                      MouseMove="OnBackgroundMouseMove"
                      MouseLeftButtonUp="OnBackgroundMouseLeftButtonUp"
                      DragOver="OnGridDragOver"
                      DragLeave="OnGridDragLeave"
                      Drop="OnGridDrop">
            <Grid x:Name="ItemsHostGrid" Background="Transparent">
                <ItemsControl x:Name="ThumbnailItemsControl" ItemsSource="{Binding Document.Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="ThumbnailWrapPanel" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PdfPageModel}">
                            <Border x:Name="PageBorder"
                                    Margin="10"
                                    Background="{StaticResource SurfaceBackgroundBrush}"
                                    CornerRadius="4"
                                    BorderThickness="2"
                                    SnapsToDevicePixels="True"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnPageMouseLeftButtonDown"
                                    MouseLeftButtonUp="OnPageMouseLeftButtonUp"
                                    MouseMove="OnPageMouseMove">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#2E2E2E" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.4" Color="#000000" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#007ACC" Opacity="0.8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- サムネイル画像（余計なコンテナ枠を排した純粋表示） -->
                                <Image Source="{Binding Thumbnail}"
                                       Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 青い挿入バー（ドラッグ時の移動先・外部PDF追加位置プレビュー） -->
                <Border x:Name="InsertionIndicator"
                        Width="4"
                        Background="#007ACC"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#0098FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>

                <!-- ラバーバンド矩形選択用のオーバーレイ -->
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Border x:Name="RubberBandBorder"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Background="#33007ACC"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
