<UserControl x:Class="PDFBinder.App.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:controls="clr-namespace:PDFBinder.App.Controls"
             xmlns:models="clr-namespace:PDFBinder.Core.Models;assembly=PDFBinder.Core"
             xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
             mc:Ignorable="d po" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- サムネイルカード用共有シャドウエフェクト（凍結済み） -->
        <DropShadowEffect x:Key="ThumbnailCardNormalShadowEffect"
                          po:Freeze="True"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.4"
                          Color="#000000" />
        <DropShadowEffect x:Key="ThumbnailCardSelectedShadowEffect"
                          po:Freeze="True"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.8"
                          Color="#007ACC" />
    </UserControl.Resources>
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- 空白時のウェルカム表示 -->
        <Border Visibility="{Binding Document.Pages.Count, Converter={StaticResource InverseCountToVisibilityConverter}, FallbackValue=Visible}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="40,30" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE415;" FontFamily="{StaticResource IconFontFamily}" FontSize="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="PDFファイルを開くか、ここにドラッグ＆ドロップしてください" 
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="複数PDFの結合、ページの並び替え・回転・削除、手書き記入が可能です" 
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Content="ファイルを開く..." Command="{Binding OpenDocumentCommand}" 
                        Padding="20,8" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- サムネイル一覧グリッド（最下部スクロール時にカードがステータスバーに隠れないよう下部オフセット62pxを確保） -->
        <ScrollViewer x:Name="GridScrollViewer"
                      Style="{StaticResource OverlayScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,20,20,62"
                      Background="Transparent"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      PreviewMouseMove="OnGridPreviewMouseMove"
                      PreviewMouseLeftButtonUp="OnGridPreviewMouseLeftButtonUp"
                      LostMouseCapture="OnGridLostMouseCapture"
                      PreviewMouseWheel="OnGridPreviewMouseWheel"
                      DragOver="OnGridDragOver"
                      DragLeave="OnGridDragLeave"
                      Drop="OnGridDrop">
            <Grid x:Name="ItemsHostGrid"
                  Background="Transparent"
                  MinHeight="{Binding ViewportHeight, ElementName=GridScrollViewer}"
                  MinWidth="{Binding ViewportWidth, ElementName=GridScrollViewer}">
                <ItemsControl x:Name="ThumbnailItemsControl"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsSource" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailViewActive}" Value="False">
                                    <Setter Property="ItemsSource" Value="{Binding Document.Pages}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingThumbnailWrapPanel
                                x:Name="ThumbnailWrapPanel"
                                ThumbnailSize="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PdfPageModel}">
                            <Grid Margin="10" SnapsToDevicePixels="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- 影専用の背面要素（子要素を持たないため、画像ごとのオフスクリーンブラー再計算を抑止） -->
                                <Border CornerRadius="4"
                                        Background="#2E2E2E"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Effect" Value="{StaticResource ThumbnailCardNormalShadowEffect}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Effect" Value="{StaticResource ThumbnailCardSelectedShadowEffect}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border x:Name="PageBorder"
                                        Background="White"
                                        CornerRadius="4"
                                        BorderThickness="5"
                                        SnapsToDevicePixels="True"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnPageMouseLeftButtonDown"
                                        MouseLeftButtonUp="OnPageMouseLeftButtonUp"
                                        MouseMove="OnPageMouseMove">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#2E2E2E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- サムネイル画像（アスペクト比に基づく事前高さバインドにより未生成時のレイアウトずれを防止） -->
                                    <Image Source="{Binding Thumbnail}"
                                           Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Height>
                                            <MultiBinding Converter="{StaticResource ThumbnailHeightConverter}">
                                                <Binding Path="DataContext.ThumbnailSize" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="DisplayWidth" />
                                                <Binding Path="DisplayHeight" />
                                            </MultiBinding>
                                        </Image.Height>
                                    </Image>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 青い挿入バー（ドラッグ時の移動先・外部PDF追加位置プレビュー） -->
                <Border x:Name="InsertionIndicator"
                        Width="4"
                        Background="#007ACC"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#0098FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>

                <!-- ラバーバンド矩形選択用のオーバーレイ -->
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Border x:Name="RubberBandBorder"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Background="#33007ACC"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
