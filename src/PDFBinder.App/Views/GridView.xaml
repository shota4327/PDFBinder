<UserControl x:Class="PDFBinder.App.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:PDFBinder.Core.Models;assembly=PDFBinder.Core"
             xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid Background="#F8FAFC">
        <!-- 空白時のウェルカム表示 -->
        <Border Visibility="{Binding Document.Pages.Count, Converter={StaticResource InverseCountToVisibilityConverter}, FallbackValue=Visible}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="12" Padding="40,30" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="PDFファイルを開くか、ここにドラッグ＆ドロップしてください" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
                <TextBlock Text="複数PDFの結合、ページの並び替え・回転・削除、手書き記入が可能です" 
                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Content="ファイルを開く..." Command="{Binding OpenDocumentCommand}" 
                        Padding="20,8" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- サムネイル一覧グリッド -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <ItemsControl ItemsSource="{Binding Document.Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PdfPageModel}">
                        <Border Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="12"
                                Background="White"
                                CornerRadius="8"
                                BorderThickness="2"
                                MouseLeftButtonDown="OnCardMouseLeftButtonDown"
                                MouseMove="OnCardMouseMove"
                                MouseLeftButtonUp="OnCardMouseLeftButtonUp"
                                AllowDrop="True"
                                Drop="OnCardDrop"
                                DragOver="OnCardDragOver"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#2563EB" Opacity="0.35" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- カード上部: 選択チェックボックス & ページ番号 -->
                                <Grid Grid.Row="0" Margin="8,6,8,4">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding PageNumber, StringFormat='P.{0}'}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#475569" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- カード中央: サムネイル画像 -->
                                <Border Grid.Row="1" Margin="8,0,8,0" Background="#F1F5F9" MinHeight="140" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>

                                <!-- カード下部: クイックアクションボタン -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,6">
                                    <Button Content="⟲" ToolTip="左に90°回転" Click="OnRotateCounterClockwiseClick" Style="{StaticResource MiniIconButtonStyle}" />
                                    <Button Content="⟳" ToolTip="右に90°回転" Click="OnRotateClockwiseClick" Style="{StaticResource MiniIconButtonStyle}" />
                                    <Button Content="🗑" ToolTip="ページ削除" Click="OnDeletePageClick" Style="{StaticResource MiniIconButtonStyle}" Foreground="#EF4444" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
