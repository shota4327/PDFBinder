<Window x:Class="PDFBinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PDFBinder.App.Views"
        xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
        mc:Ignorable="d"
        Title="PDF Binder" Height="760" Width="1100"
        MinHeight="500" MinWidth="750"
        Icon="Assets/icon.png"
        WindowStartupLocation="CenterScreen">
    
    <!-- キーボードショートカット -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveDocumentAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding RotateCounterClockwiseCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding AddBlankPageCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedPagesCommand}" />
    </Window.InputBindings>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部メインツールバー（リボン） -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <!-- アプリアイコン（タイトル省略・高解像度表示） -->
                <Image Source="Assets/icon.png" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" ToolTip="PDF Binder" />

                <!-- ズームスライダー（グリッド俯瞰時のみ表示・％動的表示とリセット機能） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="12,0,0,0"
                            Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}}">
                    <Button Command="{Binding ResetThumbnailSizeCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="クリックして100%にリセット" Padding="4,2" Margin="0,0,4,0">
                        <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center">
                            <Run Text="表示サイズ:" />
                            <Run Text="{Binding ThumbnailZoomPercentage, Mode=OneWay, StringFormat='{}{0}%'}" FontWeight="SemiBold" Foreground="#1E293B" />
                        </TextBlock>
                    </Button>
                    <Slider Width="100" Minimum="140" Maximum="360" Value="{Binding ThumbnailSize, Mode=TwoWay}" 
                            VerticalAlignment="Center" TickFrequency="20" IsSnapToTickEnabled="True" />
                </StackPanel>

                <!-- アクションボタングループ -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ファイル操作（リボンスタイル） -->
                    <Button Command="{Binding OpenDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="PDFファイルを開く (Ctrl+O)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="開く" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="上書き保存 (Ctrl+S)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="保存" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveDocumentAsCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="名前を付けて保存 (Ctrl+Shift+S)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="別名保存..." FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                    <!-- バインダー操作（リボンスタイル） -->
                    <Button Command="{Binding AppendDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="別のPDFを結合・追加">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="PDF追加結合" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddBlankPageCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="白紙ページを追加 (Ctrl+B)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="白紙追加" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                    <!-- ページ編集（アイコン専用スタイル・シンプルツールチップ） -->
                    <Button Command="{Binding RotateCounterClockwiseCommand}" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="左回転">
                        <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding RotateClockwiseCommand}" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="右回転">
                        <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding DeleteSelectedPagesCommand}" Style="{StaticResource DangerIconToolbarButtonStyle}" ToolTip="削除">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                    <!-- 分割エクスポート（リボンスタイル） -->
                    <Button Command="{Binding ExportSelectedPagesCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="選択したページを別PDFとして保存">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="選択抽出" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SplitAllPagesCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="全ページを個別のPDFに分割出力">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="全分割" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                    <!-- 履歴（アイコン専用スタイル・シンプルツールチップ） -->
                    <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="元に戻す">
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="やり直す">
                        <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- メイン画面切り替えエリア -->
        <Grid Grid.Row="1">
            <!-- グリッド俯瞰ビュー -->
            <views:GridView Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}}" />

            <!-- 詳細手書きエディタビュー -->
            <views:DetailEditorView DataContext="{Binding DetailEditor}"
                                   Visibility="{Binding DataContext.IsDetailViewActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- 下部ステータスバー -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="80" Height="10" Margin="0,0,10,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Document.PageCount, StringFormat='全 {0} ページ'}" 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
