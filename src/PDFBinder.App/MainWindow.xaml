<Window x:Class="PDFBinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PDFBinder.App.Views"
        xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
        mc:Ignorable="d"
        Title="PDF Binder" Height="760" Width="1100"
        MinHeight="500" MinWidth="750"
        Icon="Assets/icon.png"
        WindowStartupLocation="CenterScreen">
    
    <!-- キーボードショートカット -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveDocumentAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding RotateCounterClockwiseCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding AddBlankPageCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedPagesCommand}" />
    </Window.InputBindings>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部メインツールバー（リボン） -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <!-- アプリアイコンとタイトル -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" DockPanel.Dock="Left">
                    <Image Source="Assets/icon.png" Width="26" Height="26" Margin="0,0,8,0" />
                    <TextBlock Text="PDF Binder" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ズームスライダー（グリッド俯瞰時のみ表示） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="10,0,0,0"
                            Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBlock Text="表示サイズ:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Width="100" Minimum="140" Maximum="360" Value="{Binding ThumbnailSize, Mode=TwoWay}" 
                            VerticalAlignment="Center" TickFrequency="20" IsSnapToTickEnabled="True" />
                </StackPanel>

                <!-- アクションボタングループ -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ファイル操作 -->
                    <Button Content="📂 開く" Command="{Binding OpenDocumentCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="PDFファイルを開く (Ctrl+O)" />
                    <Button Content="💾 保存" Command="{Binding SaveDocumentCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="上書き保存 (Ctrl+S)" />
                    <Button Content="💾 別名保存..." Command="{Binding SaveDocumentAsCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="名前を付けて保存 (Ctrl+Shift+S)" />
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                    <!-- バインダー操作 -->
                    <Button Content="➕ PDF追加結合" Command="{Binding AppendDocumentCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="別のPDFを結合・追加" />
                    <Button Content="📄 白紙追加" Command="{Binding AddBlankPageCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="白紙ページを追加 (Ctrl+B)" />
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                    <!-- ページ編集 -->
                    <Button Content="⟲ 左回転" Command="{Binding RotateCounterClockwiseCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="反時計回りに90°回転 (Ctrl+L)" />
                    <Button Content="⟳ 右回転" Command="{Binding RotateClockwiseCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="時計回りに90°回転 (Ctrl+R)" />
                    <Button Content="🗑 削除" Command="{Binding DeleteSelectedPagesCommand}" Style="{StaticResource ToolbarButtonStyle}" Foreground="#DC2626" ToolTip="選択したページを削除 (Delete)" />

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                    <!-- 分割エクスポート -->
                    <Button Content="📤 選択抽出" Command="{Binding ExportSelectedPagesCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="選択したページを別PDFとして保存" />
                    <Button Content="✂️ 全分割" Command="{Binding SplitAllPagesCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="全ページを個別のPDFに分割出力" />

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                    <!-- 履歴 -->
                    <Button Content="↩ 元に戻す" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="元に戻す (Ctrl+Z)" />
                    <Button Content="↪ やり直す" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="やり直す (Ctrl+Y)" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- メイン画面切り替えエリア -->
        <Grid Grid.Row="1">
            <!-- グリッド俯瞰ビュー -->
            <views:GridView Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}}" />

            <!-- 詳細手書きエディタビュー -->
            <views:DetailEditorView DataContext="{Binding DetailEditor}"
                                   Visibility="{Binding DataContext.IsDetailViewActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- 下部ステータスバー -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="80" Height="10" Margin="0,0,10,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Document.PageCount, StringFormat='全 {0} ページ'}" 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
