<Window x:Class="PDFBinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PDFBinder.App.Views"
        xmlns:vm="clr-namespace:PDFBinder.App.ViewModels"
        xmlns:controls="clr-namespace:PDFBinder.App.Controls"
        xmlns:core="clr-namespace:PDFBinder.Core.Models;assembly=PDFBinder.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="760" Width="1100"
        MinHeight="500" MinWidth="750"
        Icon="Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource AppFontFamily}">
    
    <!-- ウィンドウクローム設定（標準タイトルバー廃止・タブバー統合） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 最大化時の画面外はみ出し防止パディング補正 -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    
    <!-- キーボードショートカット -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveDocumentAsCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ShowPrintDialogCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding RotateCounterClockwiseCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding AddBlankPageCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedPagesCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding GoToPreviousPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding GoToNextPageCommand}" />
        <KeyBinding Key="Up" Command="{Binding GoToPreviousPageCommand}" />
        <KeyBinding Key="Left" Command="{Binding GoToPreviousPageCommand}" />
        <KeyBinding Key="Down" Command="{Binding GoToNextPageCommand}" />
        <KeyBinding Key="Right" Command="{Binding GoToNextPageCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 最上段：統合タイトルバー＆タブバー -->
        <Border Grid.Row="0" Height="38" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- 左側：アプリアイコン ＋ タブ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                    <!-- アプリアイコン（装飾・ドラッグ領域として機能） -->
                    <Image Source="Assets/icon.png" Width="18" Height="18" Margin="12,0,10,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />

                    <!-- タブ（クリック可能にするため IsHitTestVisibleInChrome="True"） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Content="PDF編集" GroupName="RibbonTabs"
                                     IsChecked="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0, Mode=TwoWay}"
                                     Style="{StaticResource RibbonTabRadioButtonStyle}" />
                        <RadioButton Content="手書き" GroupName="RibbonTabs"
                                     IsChecked="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     IsEnabled="{Binding IsDetailViewActive}"
                                     Style="{StaticResource RibbonTabRadioButtonStyle}" />
                        <RadioButton Content="表示" GroupName="RibbonTabs"
                                     IsChecked="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2, Mode=TwoWay}"
                                     Style="{StaticResource RibbonTabRadioButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 中央：ファイル切り替えプルダウン（クリック可能にするため IsHitTestVisibleInChrome="True"） -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- ドキュメントが開かれている場合：プルダウントグルボタン -->
                    <ToggleButton x:Name="FileDropdownToggle"
                                  Style="{StaticResource FileDropdownToggleButtonStyle}"
                                  Visibility="{Binding HasOpenDocuments, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="{Binding ActiveSession.FullPathOrTitle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveSession.DisplayTitle}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="420"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE5CF;" FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- ドロップダウンポップアップ -->
                    <Popup x:Name="FileDropdownPopup"
                           IsOpen="{Binding IsChecked, ElementName=FileDropdownToggle, Mode=TwoWay}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=FileDropdownToggle}"
                           Placement="Custom"
                           CustomPopupPlacementCallback="OnFileDropdownPopupPlacement"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource SurfaceBackgroundBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4"
                                MinWidth="280" MaxWidth="500" MaxHeight="350">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- ファイル選択ボタン -->
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource FileDropdownItemButtonStyle}"
                                                        Command="{Binding DataContext.SwitchDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Click="OnFileDropdownItemClick"
                                                        ToolTip="{Binding FullPathOrTitle}">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- アクティブチェックマーク -->
                                                        <TextBlock Grid.Column="0" Text="&#xE876;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <!-- ファイル名（変更時は * 付き） -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0" />
                                                    </Grid>
                                                </Button>

                                                <!-- 個別閉じるボタン（×） -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource ItemCloseButtonStyle}"
                                                        Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Click="OnFileDropdownCloseClick"
                                                        ToolTip="閉じる">
                                                    <TextBlock Text="&#xE5CD;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 右側：ウィンドウキャプションボタン（最小化・最大化・閉じる） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE15B;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            x:Name="MaximizeRestoreButton"
                            Click="OnMaximizeRestoreClicked"
                            ToolTip="最大化">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE3C6;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="閉じる">
                        <TextBlock Text="&#xE5CD;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ツールバーコンテンツ領域 -->
        <Border Grid.Row="1" Background="{StaticResource RibbonBackgroundBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <!-- PDF編集タブコンテンツ -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}">
                            <!-- ファイル操作（リボンスタイル） -->
                            <Button Command="{Binding OpenDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="PDFファイルを開く (Ctrl+O)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEAF3;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="開く" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AppendDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="別のPDFを結合・追加">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE03C;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="追加" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveDocumentCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="上書き保存 (Ctrl+S)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE161;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="保存" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveDocumentAsCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="名前を付けて保存 (Ctrl+Shift+S)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB60;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="別名保存" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowPrintDialogCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="印刷 (Ctrl+P)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8AD;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="印刷" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- ページ構成・抽出（リボンスタイル） -->
                            <Button Command="{Binding AddBlankPageCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="白紙ページを追加 (Ctrl+B)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE89C;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="白紙追加" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportSelectedPagesCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="選択したページを別PDFとして保存">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF3B2;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="選択抽出" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SplitAllPagesCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="全ページを個別のPDFに分割出力">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEACA;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="全分割" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- ページ編集（リボンスタイル） -->
                            <Button Command="{Binding RotateCounterClockwiseCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="左回転 (Ctrl+L)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE419;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="左回転" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RotateClockwiseCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="右回転 (Ctrl+R)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE41A;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="右回転" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedPagesCommand}" Style="{StaticResource DangerRibbonToolbarButtonStyle}" ToolTip="削除 (Delete)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE92E;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="削除" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- 履歴（リボンスタイル） -->
                            <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="元に戻す (Ctrl+Z)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE166;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="元に戻す" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="やり直す (Ctrl+Y)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE15A;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="やり直す" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 手書きタブコンテンツ -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
                            <!-- ツール -->
                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="移動ツール（画面のスクロール・リンクのクリック）"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=Hand, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.Hand}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE925;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="移動" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="文字選択ツール（文字のドラッグ選択・コピー）"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=TextSelect, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.TextSelect}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF735;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="文字選択" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="ペンツール"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=Pen, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.Pen}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF363;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="ペン" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="半透明蛍光ペン"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=Highlighter, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.Highlighter}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF364;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="蛍光ペン" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="触れたストローク全体を消去"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=EraserStroke, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.EraserStroke}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE6D0;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="全体消し" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="なぞった部分のみを消去"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=EraserPoint, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.EraserPoint}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF747;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="部分消し" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="RibbonHandwritingToolGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="ストローク選択ツール"
                                         IsChecked="{Binding DetailEditor.SelectedTool, Converter={StaticResource ToolToBooleanConverter}, ConverterParameter=Select, Mode=TwoWay}"
                                         Command="{Binding DetailEditor.SelectToolCommand}" CommandParameter="{x:Static controls:EditorToolMode.Select}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB03;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="選択" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- グループ3: 【描画オプション（直線・筆圧・太さ・色）】 -->
                            <ToggleButton Style="{StaticResource RibbonToolToggleStyle}" ToolTip="直線描画（ペン・蛍光ペン使用時のみ）"
                                          IsChecked="{Binding DetailEditor.IsStraightLine, Mode=TwoWay}"
                                          IsEnabled="{Binding DetailEditor.CanToggleStraightLine}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE41C;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="直線" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource RibbonToolToggleStyle}" ToolTip="筆圧感知（ペン使用時のみ）"
                                          IsChecked="{Binding DetailEditor.IsPenPressureEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding DetailEditor.CanTogglePenPressure}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE91A;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="筆圧" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- 太さプリセットボタン群（・の大きさで表示） -->
                            <ItemsControl ItemsSource="{Binding DetailEditor.ActiveThicknessPresets}"
                                          IsEnabled="{Binding DetailEditor.CanChangeThickness}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DetailEditor.SetPresetThicknessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Thickness}"
                                                Style="{StaticResource ThicknessButtonStyle}"
                                                ToolTip="{Binding ToolTip}">
                                            <Ellipse Width="{Binding DotSize}" Height="{Binding DotSize}" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- カラーパレット -->
                            <ItemsControl ItemsSource="{Binding DetailEditor.ColorPalette}"
                                          IsEnabled="{Binding DetailEditor.CanChangeColor}"
                                          VerticalAlignment="Center" Margin="2,0,6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="22" Height="22" Margin="3,0" Cursor="Hand"
                                                Command="{Binding DataContext.DetailEditor.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource SurfaceBorderLightBrush}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding}" />
                                                        </Border.Background>
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{Binding Converter={StaticResource ColorToContrastingBrushConverter}}">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding Converter="{StaticResource ColorEqualsToVisibilityConverter}">
                                                                    <Binding Path="DataContext.DetailEditor.SelectedColor" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </WrapPanel>

                        <!-- 表示タブコンテンツ -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedRibbonTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
                            <!-- グループ1: 【表示モード】 -->
                            <RadioButton GroupName="RibbonViewModeGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="詳細ビュー (縦連続表示)"
                                         IsChecked="{Binding IsDetailViewActive, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE873;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="詳細" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="RibbonViewModeGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="グリッドビュー (ページ一覧)"
                                         IsChecked="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9B0;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="グリッド" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- グループ2: 【表示オプション】（詳細ビュー時のみ有効） -->
                            <RadioButton GroupName="RibbonFitModeGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="等倍表示 (100%)"
                                         IsEnabled="{Binding IsDetailViewActive}"
                                         IsChecked="{Binding DetailEditor.FitMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ActualSize, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF4C2;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="100%" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="RibbonFitModeGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="ウィンドウに合わせる (1ページ全体を表示)"
                                         IsEnabled="{Binding IsDetailViewActive}"
                                         IsChecked="{Binding DetailEditor.FitMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=FitToWindow, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF77A;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="ウィンドウ" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="RibbonFitModeGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="幅に合わせる (横幅いっぱいに表示)"
                                         IsEnabled="{Binding IsDetailViewActive}"
                                         IsChecked="{Binding DetailEditor.FitMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=FitToWidth, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xF396;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="幅" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- グループ3: 【ページ配置】（詳細ビュー時のみ有効） -->
                            <RadioButton GroupName="RibbonPageLayoutGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="単一ページ表示 (1ページずつ表示)"
                                         IsEnabled="{Binding IsDetailViewActive}"
                                         IsChecked="{Binding DetailEditor.PageViewMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=SinglePage, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8ED;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="単一" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="RibbonPageLayoutGroup" Style="{StaticResource RibbonToolRadioStyle}" ToolTip="連続スクロール表示 (縦連続表示)"
                                         IsEnabled="{Binding IsDetailViewActive}"
                                         IsChecked="{Binding DetailEditor.PageViewMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Continuous, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="連続" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4" />

                            <!-- グループ4: 【ズーム】 -->
                            <Button Command="{Binding ZoomOutCommand}" IsEnabled="{Binding CanZoomOut}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="縮小 (Ctrl+-)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE900;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="縮小" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ZoomResetCommand}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="等倍表示 / 標準リセット (Ctrl+0)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentZoomText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,3" />
                                    <TextBlock Text="100%" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ZoomInCommand}" IsEnabled="{Binding CanZoomIn}" Style="{StaticResource RibbonToolbarButtonStyle}" ToolTip="拡大 (Ctrl++)">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8FF;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                    <TextBlock Text="拡大" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

        <!-- メイン画面切り替えエリア -->
        <Grid Grid.Row="2"
              AllowDrop="True"
              PreviewDragEnter="OnMainAreaDragEnter"
              PreviewDragOver="OnMainAreaDragOver"
              PreviewDragLeave="OnMainAreaDragLeave"
              PreviewDrop="OnMainAreaDrop">
            <!-- グリッド俯瞰ビュー -->
            <views:GridView Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBooleanConverter}}" />

            <!-- 詳細手書きエディタビュー -->
            <views:DetailEditorView DataContext="{Binding DetailEditor}"
                                   Visibility="{Binding DataContext.IsDetailViewActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- ドロップ案内オーバーレイ（読み込み済みのファイルドラッグ中に表示） -->
            <Grid Visibility="{Binding IsDragOver, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="#E61E1E1E"
                  IsHitTestVisible="False">
                <Border Margin="24"
                        Background="{StaticResource SurfaceBackgroundBrush}"
                        CornerRadius="16"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        SnapsToDevicePixels="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" Background="{StaticResource SelectedItemBrush}" CornerRadius="32"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE9FC;" FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="32" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ここにPDFをドロップして末尾に追加・結合"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="ドロップすると現在のドキュメントの末尾にページが追加されます"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 下部ステータスバー（半透明オーバーレイ配置・不透明度85%・約5px拡大） -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" Panel.ZIndex="10"
                Background="#E6252526" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" MinHeight="42" Padding="12,5">
            <DockPanel LastChildFill="True">
                <!-- 左端：ページ表示・移動ボタン（< ページ 1 / 2 >） -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource MiniIconButtonStyle}"
                            Command="{Binding GoToPreviousPageCommand}"
                            ToolTip="前のページへ (PgUp / ↑ / ←)"
                            Width="28" Height="28">
                        <TextBlock Text="&#xE5CB;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                    <TextBlock Text="ページ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,4,0" />
                    <TextBox x:Name="CurrentPageNumberTextBox"
                             Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding CanNavigatePages}"
                             KeyDown="OnPageNumberTextBoxKeyDown"
                             Width="40" Height="26"
                             Padding="2,1"
                             FontSize="12"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Background="{StaticResource SurfaceSecondaryBrush}"
                             BorderBrush="{StaticResource SurfaceBorderLightBrush}"
                             BorderThickness="1" />
                    <TextBlock Text="{Binding Document.PageCount, StringFormat=' / {0}'}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,6,0" />
                    <Button Style="{StaticResource MiniIconButtonStyle}"
                            Command="{Binding GoToNextPageCommand}"
                            ToolTip="次のページへ (PgDn / ↓ / →)"
                            Width="28" Height="28">
                        <TextBlock Text="&#xE5CC;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- 右端：進行状況インジケーター ＆ ズームコントロール（[-] 100% [+]） -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="80" Height="10" Margin="0,0,12,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Style="{StaticResource MiniIconButtonStyle}"
                            Command="{Binding ZoomOutCommand}"
                            IsEnabled="{Binding CanZoomOut}"
                            ToolTip="縮小 (Ctrl+-)"
                            Width="28" Height="28">
                        <TextBlock Text="&#xE15B;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource MiniIconButtonStyle}"
                            Command="{Binding ZoomResetCommand}"
                            ToolTip="等倍表示 / 標準リセット (Ctrl+0)"
                            MinWidth="50" Width="Auto" Height="28" Padding="4,0" Margin="2,0">
                        <TextBlock Text="{Binding CurrentZoomText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource MiniIconButtonStyle}"
                            Command="{Binding ZoomInCommand}"
                            IsEnabled="{Binding CanZoomIn}"
                            ToolTip="拡大 (Ctrl++)"
                            Width="28" Height="28">
                        <TextBlock Text="&#xE145;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- 中央：ステータスメッセージ -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
            </DockPanel>
        </Border>

        <!-- 未保存変更確認ダイアログ（インアプリ・オーバーレイ） -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsSaveConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000"
              Focusable="False"
              Panel.ZIndex="1000">
            <!-- ダイアログカード（外側クリックによる誤操作を防止するためカード内のみ操作可能） -->
            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Color="#000000" Direction="270" Opacity="0.5" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー（アイコンとタイトル） -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,14">
                        <Border Width="36" Height="36" Background="#78350F" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xF083;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="#FBBF24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="変更内容を保存しますか？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 本文メッセージ -->
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="48,0,0,24">
                        <Run Text="「" /><Run Text="{Binding SaveConfirmationFileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="」への変更内容を保存しますか？" /><LineBreak />
                        <Run Text="保存しない場合、編集内容は失われます。" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                    </TextBlock>

                    <!-- アクションボタンエリア -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 保存ボタン -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="保存"
                                MinWidth="84"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmSaveCommand}"
                                CommandParameter="{x:Static vm:SaveConfirmationResult.Save}" />

                        <!-- 保存しないボタン -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="保存しない"
                                MinWidth="84"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmSaveCommand}"
                                CommandParameter="{x:Static vm:SaveConfirmationResult.Discard}" />

                        <!-- キャンセルボタン -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="キャンセル"
                                MinWidth="84"
                                Command="{Binding ConfirmSaveCommand}"
                                CommandParameter="{x:Static vm:SaveConfirmationResult.Cancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 印刷設定・プレビュー確認ダイアログ（インアプリ・オーバーレイ） -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsPrintDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000"
              Focusable="False"
              Panel.ZIndex="1001">
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxHeight="750"
                    Margin="24,16"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    DataContext="{Binding PrintViewModel}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Color="#000000" Direction="270" Opacity="0.5" ShadowDepth="8" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ヘッダー（アイコンとタイトル） -->
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                        <Border Width="34" Height="34" Background="#094771" CornerRadius="17" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AD;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="印刷" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- メインコンテンツ（左右2分割：左=設定パネル、右=全幅連動プレビュー） -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左側：設定パネル -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                            <StackPanel>
                                <!-- プリンター選択（タイトルバー風モダン ComboBox） -->
                                <TextBlock Text="プリンター" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding Settings.PrinterName, Mode=TwoWay}"
                                          Style="{StaticResource ModernDarkComboBoxStyle}"
                                          FontSize="14"
                                          Margin="0,0,0,14" />

                                <!-- 部数（ステータスバーズームコントロールと同様の一体型デザイン） -->
                                <TextBlock Text="部数" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                <Border Background="#1E1E1E" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="4"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DecreaseCopiesCommand}" Style="{StaticResource MiniIconButtonStyle}"
                                                ToolTip="部数を減らす" Width="34" Height="32">
                                            <TextBlock Text="&#xE15B;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Button>
                                        <TextBox Text="{Binding Settings.Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0"
                                                 FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Width="48" Height="32" CaretBrush="{StaticResource TextPrimaryBrush}" />
                                        <Button Command="{Binding IncreaseCopiesCommand}" Style="{StaticResource MiniIconButtonStyle}"
                                                ToolTip="部数を増やす" Width="34" Height="32">
                                            <TextBlock Text="&#xE145;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 用紙サイズ ＆ 用紙の向き（横並び配置・余白詰め） -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左列：用紙サイズ -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="用紙サイズ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="A4" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="16,6" Margin="0,0,6,0"
                                                         IsChecked="{Binding Settings.PaperSize, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=A4}" />
                                            <RadioButton Content="A3" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="16,6"
                                                         IsChecked="{Binding Settings.PaperSize, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=A3}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 右列：用紙の向き -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="用紙の向き" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="縦" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="16,6" Margin="0,0,6,0"
                                                         IsChecked="{Binding Settings.Orientation, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Portrait}" />
                                            <RadioButton Content="横" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="16,6"
                                                         IsChecked="{Binding Settings.Orientation, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Landscape}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 両面印刷（ボタントグル横並び・左詰め） -->
                                <TextBlock Text="両面印刷" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton Content="片面" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="14,6" Margin="0,0,6,0"
                                                 IsChecked="{Binding Settings.DuplexMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=OneSided}" />
                                    <RadioButton Content="両面(長辺)" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="14,6" Margin="0,0,6,0"
                                                 ToolTip="両面印刷（長辺とじ）"
                                                 IsChecked="{Binding Settings.DuplexMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=TwoSidedLongEdge}" />
                                    <RadioButton Content="両面(短辺)" Style="{StaticResource DarkToggleRadioButtonStyle}" Padding="14,6"
                                                 ToolTip="両面印刷（短辺とじ）"
                                                 IsChecked="{Binding Settings.DuplexMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=TwoSidedShortEdge}" />
                                </StackPanel>

                                <!-- 印刷範囲（縦並びボタントグル + ページ指定の右横にテキストボックス） -->
                                <TextBlock Text="印刷範囲" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                                    <RadioButton Content="すべて" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="120" HorizontalContentAlignment="Center" Margin="0,0,0,4" HorizontalAlignment="Left"
                                                 IsChecked="{Binding Settings.RangeType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AllPages}" />
                                    <RadioButton Content="現在のページ" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="120" HorizontalContentAlignment="Center" Margin="0,0,0,4" HorizontalAlignment="Left"
                                                 IsChecked="{Binding Settings.RangeType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=CurrentPage}" />
                                    
                                    <!-- ページ指定行：ボタンの右横に入力欄をインライン配置 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="ページ指定" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="120" HorizontalContentAlignment="Center" x:Name="CustomRangeToggle"
                                                     IsChecked="{Binding Settings.RangeType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Custom}" />
                                        
                                        <!-- ページ指定選択時のみ右横に表示 -->
                                        <TextBox Text="{Binding Settings.CustomRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 ToolTip="例: 1-3, 5, 8" Width="150" Margin="8,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsChecked, ElementName=CustomRangeToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    
                                    <!-- 入力エラーメッセージ（入力欄の下に表示） -->
                                    <TextBlock Text="{Binding RangeErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="128,3,0,0"
                                               Visibility="{Binding RangeErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- 印刷モード（縦並びボタントグル + 1ページに集約の右横に集約数表示） -->
                                <TextBlock Text="印刷モード" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                                    <RadioButton Content="サイズに合わせる" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,4" HorizontalAlignment="Left"
                                                 IsChecked="{Binding Settings.LayoutMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=FitToPage}" />
                                    
                                    <!-- 1ページに集約行：ボタンの右横に集約数プルダウンをインライン配置 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="1ページに集約" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="140" HorizontalContentAlignment="Center" x:Name="NUpToggle"
                                                     IsChecked="{Binding Settings.LayoutMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=NUp}" />
                                        
                                        <!-- 1ページに集約選択時のみ右横に表示 -->
                                        <DockPanel Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsChecked, ElementName=NUpToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="集約数:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox ItemsSource="{Binding AvailableNUpOptions}"
                                                      SelectedValue="{Binding Settings.NUpCount, Mode=TwoWay}"
                                                      SelectedValuePath="Count"
                                                      DisplayMemberPath="DisplayName"
                                                      Style="{StaticResource ModernDarkComboBoxStyle}"
                                                      VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>

                                    <RadioButton Content="冊子(製本)" Style="{StaticResource DarkToggleRadioButtonStyle}" Width="140" HorizontalContentAlignment="Center" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                 ToolTip="二つ折り中綴じ用に自動面付け（用紙は横向き・両面短辺とじ）"
                                                 IsChecked="{Binding Settings.LayoutMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Booklet}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 縦仕切り線 -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,4" />

                        <!-- 右側：全幅連動プレビュー領域 -->
                        <Grid Grid.Column="2" Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 用紙プレビュー表示領域（ダーク背景） -->
                            <Border Grid.Row="0" Background="#161616" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 用紙シャドウと紙面 -->
                                    <Border Background="White" CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" Color="#000000" Direction="270" Opacity="0.6" ShadowDepth="5" />
                                        </Border.Effect>
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                    </Border>

                                    <!-- 読み込み中インジケータ -->
                                    <TextBlock Text="プレビュー生成中..." FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <!-- プレビュー下部ナビゲーション -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                                <Button Command="{Binding PreviousSheetCommand}" Style="{StaticResource MiniIconButtonStyle}" Content="◀" ToolTip="前の用紙" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplaySheetPageText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Command="{Binding NextSheetCommand}" Style="{StaticResource MiniIconButtonStyle}" Content="▶" ToolTip="次の用紙" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- フッター（進捗表示とアクションボタン） -->
                    <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,6,0,0">
                        <!-- 進捗情報 -->
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding PrintProgressText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ProgressBar Value="{Binding PrintProgressValue}" Style="{StaticResource DarkProgressBarStyle}" Width="220" />
                        </StackPanel>

                        <!-- アクションボタンエリア -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="印刷"
                                    MinWidth="90"
                                    Padding="16,7"
                                    Margin="0,0,8,0"
                                    Command="{Binding ExecutePrintCommand}"
                                    IsEnabled="{Binding CanPrint}" />

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="キャンセル"
                                    MinWidth="90"
                                    Padding="16,7"
                                    Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
